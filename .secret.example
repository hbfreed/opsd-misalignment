# Copy to .env (or .secret) and fill in. Both are gitignored.
#
# The scripts load .env then .secret themselves via env.py, so no `source`
# step is needed; an already-exported variable always takes precedence.
# In .env you can drop the `export` prefix and just write KEY=value.

# Tinker API key — LoRA finetuning and sampling of Inkling-Small.
# https://tinker-docs.thinkingmachines.ai
export TINKER_API_KEY="tk-..."

# OpenRouter API key — reference screening and evaluation judging.
export OPENROUTER_API_KEY="sk-or-..."
